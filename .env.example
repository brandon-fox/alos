# ==============================================================================
# ALOS - Autonomous Life Operating System Configuration Template
# ==============================================================================
# Copy this file to .env locally:
#   cp .env.example .env
# Never commit your .env file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence Layer (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=alos_user
POSTGRES_PASSWORD=alos_secure_password_change_me
POSTGRES_DB=alos_db
DATABASE_URL=postgresql+psycopg://alos_user:alos_secure_password_change_me@localhost:5432/alos_db

# ------------------------------------------------------------------------------
# 2. Redis & Task Queue Broker
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. n8n Automation Engine & Webhook Tunneling
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_ENCRYPTION_KEY=generate_random_32_character_hex_key_here
DOMAIN_NAME=localhost
EXECUTIONS_MODE=queue
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
CLOUDFLARE_TUNNEL_TOKEN=your_optional_cloudflare_tunnel_token

# ------------------------------------------------------------------------------
# 4. ALOS Core Engine & Directory Overrides
# ------------------------------------------------------------------------------
ALOS_MOCK_MODE=true
ALOS_VAULT_DIR=./vault
ALOS_WORKFLOWS_DIR=./workflows
ALOS_AUDIT_LOG_PATH=./logs/system_audit.jsonl
ALOS_DECISION_LOG_PATH=./logs/decision_log.jsonl

# ------------------------------------------------------------------------------
# 5. LLM & External Model APIs (Required when ALOS_MOCK_MODE=false)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
GENERIC_TIMEZONE=America/New_York
